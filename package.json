{
  "name": "recall-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "node scripts/checks/install-hooks.mjs",
    "check": "node scripts/checks/run.mjs",
    "check:prune": "node scripts/checks/run.mjs --prune",
    "check:size": "node scripts/checks/size.mjs",
    "check:tokens": "node scripts/checks/tokens.mjs",
    "check:boundaries": "node scripts/checks/boundaries.mjs",
    "lint": "eslint --suppressions-location scripts/checks/baseline/eslint.json .",
    "test": "node scripts/checks/tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
